# ================== 应用商店环境变量模板（v1.3 远程部署） ==================
# 复制为 .env 后修改（.env 已在 .gitignore 中，不会提交到仓库）
#   cp .env.example .env

# ---- 数据库 ----
# 容器内默认用 mysql 服务名；直连本机改 localhost
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- 后端运行环境 ----
# dev / prod
SPRING_PROFILES_ACTIVE=dev
# 是否开放 Swagger 文档（生产建议 false）
SPRINGDOC_ENABLED=true

# ---- JWT（生产必须更换 secret，长度≥8位） ----
JWT_SECRET=CHANGE_ME_RANDOM_SECRET
JWT_EXPIRATION=86400000
